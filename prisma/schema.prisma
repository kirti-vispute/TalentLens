generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RECRUITER
  CLIENT
}

enum ApplicationStatus {
  SOURCED
  SCREENED
  SHORTLISTED
  CLIENT_REVIEW
  INTERVIEW
  OFFERED
  JOINED
  REJECTED
}

model ClientCompany {
  id            String        @id @default(cuid())
  name          String
  users         User[]
  requisitions  Requisition[]
  createdAt     DateTime      @default(now())
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  role            Role
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id])
  clientCompanyId String?
  createdAt       DateTime       @default(now())
  requisitions    Requisition[]  @relation("CreatedBy")
  auditLogs       AuditLog[]
}

model Requisition {
  id                String        @id @default(cuid())
  title             String
  rawJD             String
  location          String?
  experienceMin     Float         @default(0)
  experienceMax     Float         @default(99)
  noticeDaysMax     Int           @default(90)
  ctcMax            Float?
  mustHaveSkills    String // JSON string[] of {skill, weight}
  niceToHaveSkills  String // JSON string[] of {skill, weight}
  status            String        @default("OPEN")
  clientCompany     ClientCompany @relation(fields: [clientCompanyId], references: [id])
  clientCompanyId   String
  createdBy         User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  applications      Application[]
}

model Candidate {
  id              String        @id @default(cuid())
  name            String
  email           String?
  phone           String?
  currentRole     String?
  experienceYears Float?
  keySkills       String // JSON string[]
  noticeDays      Int?
  gender          String? // stored but never used for scoring
  age             Int?    // stored but never used for scoring
  maritalStatus   String? // stored but never used for scoring
  resumeText      String
  resumeFileName  String
  consentGiven    Boolean       @default(true)
  consentAt       DateTime?     @default(now())
  deletedAt       DateTime?
  duplicateOfId   String?
  createdAt       DateTime      @default(now())
  applications    Application[]
}

model Application {
  id                String            @id @default(cuid())
  requisition       Requisition       @relation(fields: [requisitionId], references: [id])
  requisitionId     String
  candidate         Candidate         @relation(fields: [candidateId], references: [id])
  candidateId       String
  score             Float
  evidence          String // JSON Evidence[]
  lowConfidence     Boolean           @default(false)
  lowConfidenceReasons String? // JSON string[]
  status            ApplicationStatus @default(SOURCED)
  rejectionReason   String?
  interviewSlot     String?
  openedByRecruiter Boolean           @default(false)
  viewedByClientAt  DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([requisitionId, candidateId])
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String
  entityType String
  entityId   String
  meta       String?
  createdAt  DateTime @default(now())
}
